--- a/iokit/Kernel/arm/DreamPanfrostCache.inc
+++ b/iokit/Kernel/arm/DreamPanfrostCache.inc
@@ -6,0 +7,8 @@
+static uint64_t dpf_wc_skips,dpf_wc_skip_bytes;
+static void dpf_wc_barrier() {
+#if defined(__aarch64__)
+    __asm__ volatile("dsb sy" ::: "memory");
+#else
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
@@ -8,0 +17,7 @@
+    // Only descriptors ACTUALLY allocated and kernel/user-mapped WC qualify.
+    // Imported surfaces and allocation fallbacks keep their full cache rules.
+    // WC writes still require publication before the doorbell and read ordering
+    // after retirement. No early completion, DMA reset or fault-state bypass.
+    if (b->writeCombined&&!b->surface) {
+        dpf_wc_barrier();++dpf_wc_skips;dpf_wc_skip_bytes+=b->size;return;
+    }
