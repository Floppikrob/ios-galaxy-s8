+    bool wc=(request->flags&PANFROST_BO_HEAP)==0;
+    if(gMaliBuffers<8)IOLog("DREAM GLES BO: allocate size=%llu flags=%x cache=%s\n",size,request->flags,wc?"write-combined":"default-heap");
