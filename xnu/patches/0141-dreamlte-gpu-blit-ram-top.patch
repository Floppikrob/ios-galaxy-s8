diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -520,6 +520,14 @@ sweet_fb_scaled_copy(uintptr_t fb, uint32_t fbBpr, uint32_t pw, uint32_t ph,
 #if defined(DREAMLTE)
 /* Generated by tools/dreamlte/mali-blit-gen.c (Mesa 25.2.8 Panfrost v6). */
 #define S8_BLIT_BASE_PA     0x8a0000000ULL
+/*
+ * S8_BLIT_BASE_PA is the GPU address the generated blob points at. Its RAM
+ * used to be the same address, right after XNU's first 512 MiB; with 2 GiB
+ * for XNU (S8_DRAM_MIB=2040) that is XNU's own memory. The blob and the
+ * Mali page-table pool now live in the last 8 MiB of the bank, kept out of
+ * XNU, and the GPU still sees the blob at S8_BLIT_BASE_PA.
+ */
+#define S8_BLIT_RAM_PA      0x8ff800000ULL
 #define S8_BLIT_SIZE        0x2000
 #define S8_BLIT_JOB         0x0
 #define S8_BLIT_TEX_SIZE    0x4c4   /* u32: (w-1) | (h-1) << 16 */
@@ -1156,7 +1164,7 @@ extern "C" void flush_dcache(vm_offset_t addr, unsigned count, int phys);
 #define S8GPU_JOB_IRQ_CLEAR     0x1004
 #define S8GPU_JS0               0x1800
 #define S8GPU_AS0               0x2400
-#define S8GPU_PT_PA             (S8_BLIT_BASE_PA + 0x10000)     /* page-table pool */
+#define S8GPU_PT_PA             (S8_BLIT_RAM_PA + 0x10000)      /* page-table pool */
 #define S8GPU_PT_PAGES          1024                            /* 4 MiB pool */
 #define S8GPU_SLOTS             16
 #define S8GPU_SLOT_VA           0x100000000ULL
@@ -1310,17 +1318,17 @@ s8gpu_init(void)
 	bool tiler_on = s8gpu_wait(0x150, tiler, tiler, 100000);
 	s8gpu_wr(0x180, s8gpu_shaders);
 	bool sh_on = s8gpu_wait(0x140, s8gpu_shaders, s8gpu_shaders, 100000);
-	s8gpu_blob = (volatile uint32_t *)ml_io_map(S8_BLIT_BASE_PA, S8_BLIT_SIZE);
+	s8gpu_blob = (volatile uint32_t *)ml_io_map(S8_BLIT_RAM_PA, S8_BLIT_SIZE);
 	s8gpu_pt = (volatile uint64_t *)ml_io_map(S8GPU_PT_PA, S8GPU_PT_PAGES * 4096);
 	if (s8gpu_blob == NULL || s8gpu_pt == NULL) {
-		IOLog("S8 GPU: cannot map the blob/page tables at 0x%llx\n", S8_BLIT_BASE_PA);
+		IOLog("S8 GPU: cannot map the blob/page tables at 0x%llx\n", S8_BLIT_RAM_PA);
 		return;
 	}
 	for (unsigned i = 0; i < S8GPU_PT_PAGES * 512; i++) {
 		s8gpu_pt[i] = 0;
 	}
 	s8gpu_pt_used = 1;                              /* page 0: level 0 */
-	bool mapped = s8gpu_map(S8_BLIT_BASE_PA, S8_BLIT_BASE_PA, S8_BLIT_SIZE) &&
+	bool mapped = s8gpu_map(S8_BLIT_BASE_PA, S8_BLIT_RAM_PA, S8_BLIT_SIZE) &&
 	    s8gpu_map(S8GPU_PANEL_PA, S8GPU_PANEL_PA, (S8GPU_PANEL_SIZE + 4095) & ~4095ULL);
 	__builtin_arm_dsb(0xf);
 	s8gpu_wr(S8GPU_AS0 + 0x00, (uint32_t)S8GPU_PT_PA);     /* AS_TRANSTAB */
