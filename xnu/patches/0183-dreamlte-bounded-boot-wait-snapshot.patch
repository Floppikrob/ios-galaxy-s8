+#ifndef DREAM_BOOT_WAIT_WALK_H
+#define DREAM_BOOT_WAIT_WALK_H
+/* Best-effort diagnostic only. The reader must never fault or wait for paging. */
+static unsigned dream_boot_wait_walk(uint64_t fp, uint64_t *out, unsigned capacity,
+    int (*read_frame)(uint64_t, uint64_t[2], void *), void *arg)
+{
+    const uint64_t user_limit=1ULL<<39, max_span=8ULL<<20;
+    uint64_t first=fp;
+    unsigned count=0;
+    if(capacity>12)capacity=12;
+    while(count<capacity && fp && !(fp&15) && fp<user_limit-16 && fp>=first && fp-first<=max_span) {
+        uint64_t frame[2];
+        if(!read_frame(fp,frame,arg))break;
+        if(!frame[1] || frame[1]>=user_limit)break;
+        out[count++]=frame[1];
+        if(frame[0]<=fp)break;
+        fp=frame[0];
+    }
+    return count;
+}
+#endif
