+extern void dream_boot_wait_task(const char *,int,task_t);
+static int dream_boot_wait_proc(proc_t p, __unused void *arg) {
+    char name[32];int pid=proc_pid(p);proc_name(pid,name,sizeof(name));
+    if(strcmp(name,"SpringBoard")&&strcmp(name,"runningboardd")&&strcmp(name,"lsd")&&strcmp(name,"backboardd"))return PROC_RETURNED;
+    task_t task=proc_task(p);if(task==TASK_NULL)return PROC_RETURNED;
+    task_reference(task);dream_boot_wait_task(name,pid,task);task_deallocate(task);
+    return PROC_RETURNED;
+}
+/* Three bounded waiting-thread snapshots, only while the shell is still tiny.
+ * Rendering, wakeups and service requests are never changed by this observer.
+ */
+static void dream_boot_wait_report(unsigned sample) {
+    for(unsigned i=0;i<256;i++) {
+        struct dream_load_row *r=&dream_load_rows[i];
+        if(r->seen==dream_load_epoch&&!strcmp(r->name,"SpringBoard")&&r->rss<(16ULL<<20)) {
+            printf("DREAM BOOT WAIT: sample=%u shell_rss_mib=%llu\n",sample,r->rss>>20);
+            proc_iterate(PROC_ALLPROCLIST,dream_boot_wait_proc,NULL,NULL,NULL);return;
+        }
+    }
+}
