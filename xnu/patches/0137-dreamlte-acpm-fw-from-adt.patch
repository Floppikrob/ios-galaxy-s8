+/* The DVFS plugin binary: built in, else the ADT's /chosen "s8-acpm-dvfs-fw". */
+static const uint8_t *dvfs_fw;
+static uint32_t dvfs_fw_len;
+
+static void
+dvfs_fw_find(void)
+{
+#if HAVE_DVFS_FW
+	dvfs_fw = s8_acpm_dvfs_fw;
+	dvfs_fw_len = (uint32_t)sizeof(s8_acpm_dvfs_fw);
+	LOG("dvfs plugin: built in, %u bytes", dvfs_fw_len);
+#else
+	DTEntry chosen;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "s8-acpm-dvfs-fw", &prop, &size) == kSuccess &&
+	    size >= 4 && (size & 3) == 0) {
+		dvfs_fw = (const uint8_t *)prop;
+		dvfs_fw_len = size;
+		LOG("dvfs plugin: from the ADT, %u bytes", dvfs_fw_len);
+	} else {
+		LOG("dvfs plugin: none (no s8_acpm_dvfs_fw.h, no ADT /chosen s8-acpm-dvfs-fw)");
+	}
+#endif
+}
