-		    __builtin_arm_rsr64("MPIDR_EL1") & 0xffffffULL,
-		    (long long)s8_cntpct_minus_cntvct(), s8_user_timebase() ? "on" : "off");
-	}
+	s8utb_record();
 #endif
 }
 
