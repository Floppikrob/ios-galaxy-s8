@@ -0,0 +1,10 @@
+/* A CPU write opportunity permanently disqualifies the private-mirror
+ * no-preclean rule, including mappings outside our read-only IOSurface path.
+ * Called BEFORE returning writable access, not after pixels were modified.
+ */
+#ifndef DREAM_SURFACE_CPU_H
+#define DREAM_SURFACE_CPU_H
+static inline void dream_surface_offer_cpu_write(SweetSurface *surface) {
+    if(surface)__atomic_store_n(&surface->cpuWriteOffered,1u,__ATOMIC_RELEASE);
+}
+#endif
