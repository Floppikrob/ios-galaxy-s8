+/* Only our signed-registered, privately allocated BGRA output mirror qualifies.
+ * First-frame/full CPU/GPU sync has already completed before registration.
+ * CPU writes/driver mappings disqualify permanently; seed mismatch also refuses.
+ * All post-job invalidation and other imported-surface rules remain intact.
+ */
+static bool dream_surface_gpu_readonly(SweetSurface *s) {
+    uint32_t seed;
+    return s && s->displayMirrorReadOnly && !s->userMemoryPrepared &&
+        !__atomic_load_n(&s->cpuWriteOffered,__ATOMIC_ACQUIRE) &&
+        sweet_surface_read_seed(s,&seed) && seed==s->displayMirrorReadOnlySeed;
+}
