diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -5857,6 +5857,24 @@ pmap_enter_options_internal(
 		panic("pmap_enter_options() pmap %p v 0x%llx",
 		    pmap, (uint64_t)v);
 	}
+#if defined(SWEET)
+	/*
+	 * Galaxy S8 diagnostic: with 4K hardware pages under 16K VM pages a
+	 * mapping must start on 16K, or write_pte_fast() panics without a
+	 * usable backtrace. Name the callers here instead.
+	 */
+	if (__improbable(TEST_PAGE_RATIO_4 && (v & 0x3fffULL))) {
+		uintptr_t ra[6] = {0};
+		uintptr_t *fp = (uintptr_t *)__builtin_frame_address(0);
+		for (int i = 0; i < 6 && fp != NULL && ((uintptr_t)fp & 0x7) == 0 &&
+		    (uintptr_t)fp >= VM_MIN_KERNEL_ADDRESS; i++) {
+			ra[i] = fp[1];
+			fp = (uintptr_t *)fp[0];
+		}
+		panic("S8 pmap_enter v 0x%llx pa 0x%llx unaligned; lr %lx %lx %lx %lx %lx %lx",
+		    (uint64_t)v, (uint64_t)pa, ra[0], ra[1], ra[2], ra[3], ra[4], ra[5]);
+	}
+#endif
 
 	/* Only check kernel_pmap here as CPUWINDOWS only exists in kernel address space. */
 	if (__improbable((pmap == kernel_pmap) && (v >= CPUWINDOWS_BASE) && (v < CPUWINDOWS_TOP))) {
