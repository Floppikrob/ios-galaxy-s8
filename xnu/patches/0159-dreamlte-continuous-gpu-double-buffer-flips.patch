+// Only entered after the full one-frame round trip has succeeded this boot.
+static void df_start_cont(uint64_t root_pa) {
+    int cont=0;PE_parse_boot_argn("s8flipcont",&cont,sizeof(cont));if(!cont) return;
+    df_m=(volatile uint32_t *)ml_io_map(0x12900000,0x1000);
+    df_d=(volatile uint32_t *)ml_io_map(0x12860000,0x1000);
+    df_i=(volatile uint32_t *)ml_io_map(0x128b1000,0x1000);
+    if(!df_m||!df_d||!df_i||df_m[0]!=4||df_m[3]||df_i[16]!=0xcc000000) return;
