+static bool dream_display_is_active() { return df_active; }
+// fPresentLock serializes both swaps and power-off transitions.
+static bool df_latch(uint32_t address) {
+    uint32_t saved=df_d[0x40/4];df_write(df_d,0x40,saved|(1u<<13)|1u);
+    df_write(df_i,0x40,address);df_write(df_i,0x44,address);
+    df_write(df_d,0x60,df_d[0x60/4]|0x8000003f);
+    bool taken=df_wait(df_d,0x60,0x8000003f,0,100);
+    df_write(df_d,0x4c,1u<<13);
+    bool done=taken&&df_wait(df_d,0x4c,1u<<13,1u<<13,40);
+    df_write(df_d,0x40,saved);
+    return taken&&done&&!df_m[0x60/4];
+}
+static bool dream_display_to_boot() {
+    if(!df_active) return !df_failed;
+    if(!df_failed && df_front==0 && !(df_d[0x60/4]&0x8000003f)) return true;
+    if(df_latch(0xcc000000)) {df_front=0;return true;}
+    df_failed=true;
+    IOLog("DREAM FLIP CONT: return-to-boot failed; retain DMA, suppress writes\n");
+    return false;
+}
+static bool dream_display_frame_ok(const uint8_t *rec) {
+    if(df_failed) return false;
+    bool full=get32(rec,0x104)==1 && get32(rec,0x64)==0 && get32(rec,0x68)==0 &&
+        get32(rec,0x6c)==1125 && get32(rec,0x70)==2436 &&
+        get32(rec,0xc4)==0 && get32(rec,0xc8)==0 && get32(rec,0xcc)==1125 && get32(rec,0xd0)==2436;
+    if(!full && !dream_display_to_boot()) return false;
+    return true;
+}
+static int dream_display_frame_copy(SweetSurface *src,SweetSurface *boot,unsigned w,unsigned h,unsigned sb,unsigned db) {
+    if(df_failed) return -1;
+    if(!df_active) return 0;
+    unsigned target=1-df_front;
+    SweetSurface *dst=target?sweet_stage_surface:boot;
+    int ret=dream_gpu_frame_copy(src,dst,w,h,sb,db);
+    if(ret<=0) {
+        bool safe=dream_display_to_boot();
+        IOLog("DREAM FLIP CONT: GPU copy unavailable result=%d boot_safe=%u\n",ret,safe);
+        return ret<0||!safe?-1:0;
+    }
+    uint64_t begin=mach_absolute_time();
+    if(!df_latch(target?0x70000000:0xcc000000)) {
+        // The requested buffer may be scanned even without confirmation. Never
+        // write either buffer again until a return to boot has been confirmed.
+        df_failed=true;
+        IOLog("DREAM FLIP CONT: latch timeout/fault front=%u target=%u MMU=%x; writes suppressed, DMA retained\n",
+            df_front,target,df_m[0x60/4]);
+        return -1;
+    }
+    df_front=target;
+    uint64_t ns;absolutetime_to_nanoseconds(mach_absolute_time()-begin,&ns);
+    if(++df_flip_count<=4 || df_flip_count%30==0)
+        IOLog("DREAM FLIP CONT: frame=%u front=%u latch=1 retired=1 wait_us=%llu mmu_irq=%x\n",
+            df_flip_count,df_front,ns/1000,df_m[0x60/4]);
+    return 1;
+}
