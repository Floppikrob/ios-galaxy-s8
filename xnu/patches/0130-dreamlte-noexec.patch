diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index deccec2..614631f 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7414,6 +7414,56 @@ process_signature(proc_t p, struct image_params *imgp)
 #if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 			/* A short line keeps the persistent console ring useful. */
 			printf("exec %s\n", p->p_name);
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+			{
+				/* Galaxy S8 test tools in /usr/local/bin run as platform binaries (launchd's system jobs must be) */
+				char xpath[MAXPATHLEN];
+				int xlen = sizeof(xpath);
+				if (imgp->ip_vp != NULLVP && vn_getpath(imgp->ip_vp, xpath, &xlen) == 0 &&
+				    strncmp(xpath, "/usr/local/bin/", 15) == 0) {
+					proc_lock(p);
+					proc_csflags_set(p, CS_PLATFORM_BINARY | CS_VALID | CS_SIGNED);
+					proc_unlock(p);
+					printf("exec %s: platform (s8 tool)\n", xpath);
+				}
+			}
+			/*
+			 * Boot-arg s8noexec=NAME,NAME,...: refuse these programs. Daemons
+			 * that crash on this hardware (bluetoothd, fairplayd.H2, ...) were
+			 * respawned more than a thousand times a session: every launch is a
+			 * full dyld start, page faults and a crash report, on four A53s.
+			 */
+			{
+				static char s8noexec[256];
+				static int s8noexec_read = 0;
+				if (!s8noexec_read) {
+					if (!PE_parse_boot_argn("s8noexec", s8noexec, sizeof(s8noexec))) {
+						s8noexec[0] = '\0';
+					}
+					s8noexec_read = 1;
+				}
+				size_t nl = strlen(p->p_name);
+				for (const char *t = s8noexec; nl && *t;) {
+					const char *e = strchr(t, ',');
+					size_t tl = e ? (size_t)(e - t) : strlen(t);
+					if (tl == nl && strncmp(t, p->p_name, nl) == 0) {
+						printf("exec %s refused (s8noexec)\n", p->p_name);
+						signature_failure_reason = os_reason_create(OS_REASON_EXEC,
+						    EXEC_EXIT_REASON_WRONG_PLATFORM);
+						if (signature_failure_reason != OS_REASON_NULL) {
+							/* no ReportCrash run per refused launch */
+							signature_failure_reason->osr_flags |= OS_REASON_FLAG_NO_CRASH_REPORT;
+						}
+						error = EACCES;
+						goto done;
+					}
+					if (!e) {
+						break;
+					}
+					t = e + 1;
+				}
+			}
+#endif
 #else
 			printf("Allowing spawn of iOS binary %s since it has "
 			    "com.apple.private.security.no-sandbox entitlement or unentitled_ios_sim_launch "
diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
index 9c06ccd..596b5da 100644
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -4721,6 +4721,20 @@ ubc_cs_blob_add(
 		OS_PTRAUTH_DISCRIMINATOR("cs_blob.csb_entitlements")));
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	{
+		/*
+		 * Galaxy S8 test tools: ad-hoc signed binaries in /usr/local/bin count
+		 * as platform binaries, so launchd runs them from its system cache
+		 * (it panics on a non-platform binary there). AMFI is permissive here.
+		 */
+		char path[MAXPATHLEN];
+		int len = sizeof(path);
+		if (vn_getpath(vp, path, &len) == 0 && strncmp(path, "/usr/local/bin/", 15) == 0) {
+			cs_flags |= CS_PLATFORM_BINARY;
+		}
+	}
+#endif
 	tmp_blob.csb_flags = cs_flags;
 	tmp_blob.csb_signer_type = signer_type;
 
