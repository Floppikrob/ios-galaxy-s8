+++ b/bsd/dev/sweet_ufs.c
@@ -880,7 +880,9 @@ sweet_ufs_rootdev(dev_t *dev)
 	/* boot-arg s8wlan=N (bsd/dev/s8_wlan.c): started once, whether or not a root is found */
 	extern void s8_wlan_start(void);
 	extern void s8_cpufreq_start(void);
-	s8_cpufreq_start();             /* boot-arg s8cpufreq=KHZ (bsd/dev/s8_cpufreq.c) */
+	extern void s8_load_start(void);
+	s8_cpufreq_start();
+	s8_load_start();                /* per-CPU load every 10 s (osfmk/kern/s8_load.c) */             /* boot-arg s8cpufreq=KHZ (bsd/dev/s8_cpufreq.c) */
 	s8_wlan_start();
 #endif
 	if (!su.ready) {
diff --git a/osfmk/conf/files b/osfmk/conf/files
