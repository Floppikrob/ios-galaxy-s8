From b2d1dc1c9203854067cc0f6af8d1392fe3ee40e7 Mon Sep 17 00:00:00 2001
From: local <local@s8>
Date: Wed, 21 Oct 2026 03:19:49 +0300
Subject: [PATCH] dreamlte: per-CPU load log (S8LOAD)

---
 bsd/dev/sweet_ufs.c  |   4 +-
 osfmk/conf/files     |   1 +
 osfmk/kern/s8_load.c | 167 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 171 insertions(+), 1 deletion(-)
 create mode 100644 osfmk/kern/s8_load.c

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
