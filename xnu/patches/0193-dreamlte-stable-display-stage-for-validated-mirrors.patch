--- /dev/null
+++ b/iokit/Kernel/arm/DreamBgraStage.h
@@ -0,0 +1,20 @@
+/* Bounded bit-identical BGRA row copy for the stable GPU display source.
+ * No format conversion, alpha math, scaling, SIMD or per-frame GPU mappings.
+ */
+#ifndef DREAM_BGRA_STAGE_H
+#define DREAM_BGRA_STAGE_H
+#include "DreamB3a8.h"
+#include <string.h>
+static inline int dream_bgra_stage_rows(uint8_t *out,size_t no,size_t ro,
+    const uint8_t *in,size_t ni,size_t ri,uint32_t width,uint32_t height)
+{
+    if(!out || !in || !dream_b3a8_span(no,ro,width,height,4) ||
+        !dream_b3a8_span(ni,ri,width,height,4))return 0;
+    const size_t used=(size_t)width*4;
+    const size_t os=ro*(height-1)+used,is=ri*(height-1)+used;
+    const uintptr_t oa=(uintptr_t)out,ia=(uintptr_t)in;
+    if(oa>UINTPTR_MAX-os || ia>UINTPTR_MAX-is || (oa<ia+is && ia<oa+os))return 0;
+    for(uint32_t y=0;y<height;y++)memcpy(out+(size_t)y*ro,in+(size_t)y*ri,used);
+    return 1;
+}
+#endif
