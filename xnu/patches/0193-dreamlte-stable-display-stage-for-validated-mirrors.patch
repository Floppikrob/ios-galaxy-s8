+    if (SweetSurface *mirror=dream_display_mirror_copy(source,width,height)) {
+        const uint64_t begin=mach_absolute_time();
+        bool copied=stage->memory!=mirror->memory &&
+            dream_bgra_stage_rows((uint8_t *)out,stage->memory->getLength(),stage->bytesPerRow,
+                (const uint8_t *)mirror->kernelAddress(),mirror->memory->getLength(),mirror->bytesPerRow,width,height);
+        unsigned mirrorID=mirror->id;mirror->release();
+        if(copied) {
+            static unsigned copies;unsigned number=++copies;
+            if(number<=8 || number%120==0) {
+                uint64_t ns;absolutetime_to_nanoseconds(mach_absolute_time()-begin,&ns);
+                IOLog("DREAM DISPLAY STAGE: copy=%u source=%u mirror=%u stage=%u row_copy_us=%llu unpack_skipped=1 stable_GPU_source=1\n",
+                    number,source->id,mirrorID,stage->id,ns/1000);
+            }
+            stage->retain();return stage;
+        }
+    }
