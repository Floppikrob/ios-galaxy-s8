+/* Completed GPU writes may be invalidated once at the CPU ownership boundary.
+ * No worker takes gMaliLock. Surface submissions are still synchronous under it.
+ * Root locks hold no root/table mutex while entering this function.
+ */
+static uint64_t dpf_mirror_cpu_syncs,dpf_mirror_cpu_sync_bytes;
+static bool dream_surface_sync_cpu_locked(SweetSurface *surface) {
+    if(!surface)return true;
+    const uint64_t dirty=__atomic_load_n(&surface->deferredInvalidateSeq,__ATOMIC_ACQUIRE);
+    const bool owned=__atomic_load_n(&surface->displayMirrorReadOnly,__ATOMIC_ACQUIRE);
+    if(!dirty && !owned)return true;
+    if(!hakios_mali_ready())return false;
+    uint64_t current=__atomic_load_n(&surface->maliSeq,__ATOMIC_ACQUIRE);
+    if(current==~0ULL || (current && !hakios_mali_wait(current,0)))return false;
+    if(!dirty)return true;
+    if(!hakios_mali_wait(dirty,0) || !surface->memory)return false;
+    void *address=(void*)surface->kernelAddress();
+    const uint64_t bytes=surface->allocSize;
+    if(!address || !bytes || bytes>surface->memory->getLength())return false;
+    dm_invalidate(address,bytes); // BEFORE CPU load or writable mapping is returned.
+    __atomic_store_n(&surface->deferredInvalidateSeq,0ULL,__ATOMIC_RELEASE);
+    ++dpf_mirror_cpu_syncs;dpf_mirror_cpu_sync_bytes+=bytes;
+    if(dpf_mirror_cpu_syncs<=8 || dpf_mirror_cpu_syncs%120==0)
+        IOLog("DREAM MIRROR CPU SYNC: count=%llu surface=%u seq=%llu bytes=%llu completed=1\n",
+            dpf_mirror_cpu_syncs,surface->id,dirty,bytes);
+    return true;
+}
+bool dream_surface_sync_cpu(SweetSurface *surface) {
+    // The owned flag ALSO enters the lock with no dirty seq yet: another client
+    // may currently hold it while GPU output is still running, before publication.
+    if(!surface || (!__atomic_load_n(&surface->deferredInvalidateSeq,__ATOMIC_ACQUIRE) &&
+        !__atomic_load_n(&surface->displayMirrorReadOnly,__ATOMIC_ACQUIRE)))return true;
+    if(!gMaliLock)return false;
+    IOLockLock(gMaliLock);
+    bool ok=dream_surface_sync_cpu_locked(surface);
+    IOLockUnlock(gMaliLock);return ok;
+}
