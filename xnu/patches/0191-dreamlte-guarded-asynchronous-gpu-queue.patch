+/* One immutable bounded user-handle snapshot per SUBMIT. */
+struct dpf_submit_snapshot {
+    uint32_t *values; unsigned count;
+    dpf_submit_snapshot():values(NULL),count(0) {}
+    ~dpf_submit_snapshot() {if(values)IODelete(values,uint32_t,count);}
+    IOReturn load(uint64_t user,unsigned n) {
+        if(n>4096)return kIOReturnBadArgument;
+        count=n;if(!n)return kIOReturnSuccess;
+        values=IONew(uint32_t,n);if(!values)return kIOReturnNoMemory;
+        return copyin((user_addr_t)user,values,n*sizeof(*values))?kIOReturnBadArgument:kIOReturnSuccess;
+    }
+};
+static bool dpf_async_buffer(const struct mali_buffer *b)
+{
+    return b && b->memory && !b->surface &&
+        (b->writeCombined || (!b->cpuMapped && b->cachePrimed));
+}
