+/* Another verified Mongoose leaves compositor core6 available for preparation. */
+void dream_bind_gpu_worker_cpu(void);
+void dream_bind_gpu_worker_cpu(void)
+{
+    if(real_ncpus!=8)return;
+    processor_t p=cpu_to_processor(5);
+    if(!p || p->state<PROCESSOR_IDLE)return;
+    (void)thread_bind(p);
+    if(cpu_number()!=5)(void)thread_block(NULL);
+    printf("DREAM GLES CPU: worker bound=5 mpidr=1 role=Mongoose now=%u\n",cpu_number());
+}
