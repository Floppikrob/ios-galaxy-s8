--- /dev/null
+++ b/iokit/Kernel/arm/DreamPanfrostQueue.inc
@@ -0,0 +1,96 @@
+/* HakiOS FIFO policy; worker never takes gMaliLock. Client last_seq pins
+ * every listed BO. Cached surfaces are waited/invalidate-completed by caller. */
+#ifndef DREAM_PANFROST_QUEUE_TEST
+#include <kern/thread.h>
+extern "C" void dream_bind_gpu_worker_cpu(void);
+#endif
+static const unsigned DPF_QUEUE_CAPACITY=64;
+static IOLock *dpf_queue_lock;
+static bool dpf_queue_started;
+static struct {uint64_t chain,seq;bool fragment;} dpf_queue[DPF_QUEUE_CAPACITY];
+static unsigned dpf_queue_head,dpf_queue_count,dpf_queue_peak;
+static uint64_t dpf_queue_async,dpf_queue_sync;
+static void dpf_completion_barrier() {
+#if defined(__aarch64__)
+        __asm__ volatile("dsb sy" ::: "memory");
+#else
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
+static void dpf_queue_worker(void *,wait_result_t)
+{
+    dream_bind_gpu_worker_cpu();
+    for (;;) {
+        IOLockLock(dpf_queue_lock);
+        while (!dpf_queue_count || !hakios_mali_ready())
+            IOLockSleep(dpf_queue_lock,&dpf_queue_count,THREAD_UNINT);
+        const uint64_t chain=dpf_queue[dpf_queue_head].chain;
+        const uint64_t seq=dpf_queue[dpf_queue_head].seq;
+        const bool fragment=dpf_queue[dpf_queue_head].fragment;
+        IOLockUnlock(dpf_queue_lock);
+        const uint64_t start=mach_absolute_time();
+        const bool ok=dpf_execute_chain(chain,fragment,seq);
+        if(!ok){
+            dpf_poison_queue(); // Never skip failed work and retire a later sequence.
+            IOLog("DREAM GLES QUEUE: FAILED seq=%llu; accepted DMA storage retained\n",seq);
+        }
+dpf_completion_barrier();
+        IOLockLock(dpf_queue_lock);
+        if(ok) dpf_done=seq; // Never retire failed or merely queued work.
+        dpf_queue_head=(dpf_queue_head+1)%DPF_QUEUE_CAPACITY;
+        --dpf_queue_count;
+        if(seq<=8 || seq%300==0) {
+            uint64_t ns;absolutetime_to_nanoseconds(mach_absolute_time()-start,&ns);
+            IOLog("DREAM GLES QUEUE: retired=%llu ok=%u pending=%u peak=%u gpu_us=%llu async=%llu sync=%llu\n",
+                seq,ok,dpf_queue_count,dpf_queue_peak,ns/1000,dpf_queue_async,dpf_queue_sync);
+        }
+        IOLockWakeup(dpf_queue_lock,&dpf_done,false);
+        IOLockWakeup(dpf_queue_lock,&dpf_queue_count,false);
+        IOLockUnlock(dpf_queue_lock);
+    }
+}
+static void dpf_queue_start()
+{
+    dpf_queue_lock=IOLockAlloc();
+    if(!dpf_queue_lock) return;
+    thread_t thread;
+    if(kernel_thread_start(dpf_queue_worker,NULL,&thread)==KERN_SUCCESS) {
+        thread_deallocate(thread);dpf_queue_started=true;
+    }
+    IOLog("DREAM GLES QUEUE: enabled=%u capacity=%u cached_surfaces=sync\n",dpf_queue_started,DPF_QUEUE_CAPACITY);
+}
+static uint64_t dpf_enqueue_chain(uint64_t chain,bool fragment,bool asynchronous)
+{
+    if(!hakios_mali_ready() || !chain || (chain&7)) return 0;
+    if(!dpf_queue_started) {
+        uint64_t seq=dpf_seq+1;
+        if(!dpf_execute_chain(chain,fragment,seq)) return 0;
+        dpf_completion_barrier();dpf_seq=dpf_done=seq;return seq;
+    }
+    uint64_t deadline;clock_interval_to_deadline(2000,NSEC_PER_MSEC,&deadline);
+    IOLockLock(dpf_queue_lock);
+    while(dpf_queue_count==DPF_QUEUE_CAPACITY && hakios_mali_ready() && mach_absolute_time()<deadline)
+        IOLockSleepDeadline(dpf_queue_lock,&dpf_queue_count,deadline,THREAD_UNINT);
+    if(!hakios_mali_ready() || dpf_queue_count==DPF_QUEUE_CAPACITY) {IOLockUnlock(dpf_queue_lock);return 0;}
+    const uint64_t seq=++dpf_seq;
+    unsigned at=(dpf_queue_head+dpf_queue_count)%DPF_QUEUE_CAPACITY;
+    dpf_queue[at].chain=chain;dpf_queue[at].seq=seq;dpf_queue[at].fragment=fragment;
+    ++dpf_queue_count;
+    if(dpf_queue_count>dpf_queue_peak)dpf_queue_peak=dpf_queue_count;
+    if(asynchronous)++dpf_queue_async;else ++dpf_queue_sync;
+    IOLockWakeup(dpf_queue_lock,&dpf_queue_count,false);
+    IOLockUnlock(dpf_queue_lock);
+    return seq;
+}
+extern "C" bool hakios_mali_wait(uint64_t seq,uint64_t timeout_ns)
+{
+    if(!dpf_queue_started)return hakios_mali_ready()&&seq<=dpf_done;
+    if(timeout_ns>10ull*NSEC_PER_SEC)timeout_ns=10ull*NSEC_PER_SEC;
+    uint64_t delta,deadline;nanoseconds_to_absolutetime(timeout_ns,&delta);
+    deadline=mach_absolute_time()+delta;
+    IOLockLock(dpf_queue_lock);
+    while(hakios_mali_ready() && dpf_done<seq && timeout_ns && mach_absolute_time()<deadline)
+        IOLockSleepDeadline(dpf_queue_lock,&dpf_done,deadline,THREAD_UNINT);
+    bool done=hakios_mali_ready()&&dpf_done>=seq;
+    IOLockUnlock(dpf_queue_lock);return done;
+}
