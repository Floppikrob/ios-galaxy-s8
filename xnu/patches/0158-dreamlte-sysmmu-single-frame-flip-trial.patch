     df_tables->prepare(kIODirectionOut);dm_clean(root,table_bytes);
     IOLog("DREAM SYSMMU TABLE: %s root_pa=%llx root_ppn=%llx iova=%x bytes=%llu pages=%u sections=%u identity_bad=%u hardware_enabled=0 flip=0\n",
