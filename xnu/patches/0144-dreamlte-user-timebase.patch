diff --git a/osfmk/arm/commpage/commpage.c b/osfmk/arm/commpage/commpage.c
--- a/osfmk/arm/commpage/commpage.c
+++ b/osfmk/arm/commpage/commpage.c
@@ -53,6 +53,8 @@
 #include <libkern/OSAtomic.h>
 #include <stdatomic.h>
 #include <kern/remote_time.h>
+
+extern uint64_t ml_user_timebase_adjust(void);
 #include <machine/atomic.h>
 #include <machine/machine_remote_time.h>
 #include <machine/machine_routines.h>
@@ -725,7 +727,8 @@ void
 commpage_update_timebase(void)
 {
 	if (commPagePtr) {
-		*((uint64_t*)(_COMM_PAGE_TIMEBASE_OFFSET + _COMM_PAGE_RW_OFFSET)) = rtclock_base_abstime;
+		/* ml_user_timebase_adjust(): CNTPCT - CNTVCT where the kernel counts on CNTPCT (S8). */
+		*((uint64_t*)(_COMM_PAGE_TIMEBASE_OFFSET + _COMM_PAGE_RW_OFFSET)) = rtclock_base_abstime + ml_user_timebase_adjust();
