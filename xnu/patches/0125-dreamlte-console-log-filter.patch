 int sweet_console_muted;
+
+/*
+ * Boot-arg sweetlog=WORD,WORD,...: only console lines containing one of the
+ * words are drawn (a panic always is); everything still reaches the log.
+ * A word starting with '-' hides the lines containing it instead; with only
+ * such words every other line is drawn. A plain number (sweetlog=0/1, the
+ * persistent log switch in sweet_ufs.c) is not a filter.
+ */
+static char sweet_log_words[128];
+static int sweet_log_filter = -1;
+static char sweet_log_line[256];
+static int sweet_log_len;
+
+static bool
+sweet_log_has(const char *line, int len, const char *w, int wl)
+{
+	for (int i = 0; wl > 0 && i + wl <= len; i++) {
+		if (strncmp(line + i, w, wl) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+sweet_log_wanted(const char *line, int len)
+{
+	const char *w = sweet_log_words;
+	bool any_include = false, included = false;
+
+	while (*w) {
+		const char *end = w;
+		while (*end && *end != ',') {
+			end++;
+		}
+		if (*w == '-') {
+			if (sweet_log_has(line, len, w + 1, (int)(end - w - 1))) {
+				return false;
+			}
+		} else if (end > w) {
+			any_include = true;
+			if (!included && sweet_log_has(line, len, w, (int)(end - w))) {
+				included = true;
+			}
+		}
+		w = *end ? end + 1 : end;
+	}
+	return !any_include || included;
+}
+
+static bool
+sweet_log_is_filter(void)
+{
+	const char *w = sweet_log_words;
+
+	if (*w == '\0') {
+		return false;
+	}
+	for (; *w; w++) {
+		if (*w < '0' || *w > '9') {
+			return true;
+		}
+	}
+	return false;
+}
 #endif
 
 static inline void
@@ -296,6 +362,28 @@ _cnputs(char *c, int size, bool poll)
 	if (sweet_console_muted && !panic_active()) {
 		return;
 	}
