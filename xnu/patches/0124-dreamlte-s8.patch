+/*
+ * Boot 31 video: torn frames (top half of one screen, bottom of the
+ * next). DECON_F fetches the panel memory at 60 Hz (boot 30 probe: 30
+ * frame-done events per 0.5 s) while we copy into it. Start each copy
+ * right after a frame-done (INTERRUPT_PENDING 0x4c bit 13, source
+ * enabled in INTERRUPT_ENABLE 0x40; the SPI is not routed), so the copy
+ * runs ahead of the next fetch.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+static vm_offset_t sweet_fb_decon;
+
+static void
+sweet_fb_wait_frame_done(void)
+{
+	if (sweet_fb_decon == 0) {
+		sweet_fb_decon = ml_io_map(0x12860000, 0x1000);
+		if (sweet_fb_decon == 0) {
+			return;
+		}
+		*(volatile uint32_t *)(sweet_fb_decon + 0x40) |= (1u << 13) | 1u;
+	}
+	volatile uint32_t *pend = (volatile uint32_t *)(sweet_fb_decon + 0x4c);
+	*pend = 1u << 13;
+	for (int i = 0; i < 200 && !(*pend & (1u << 13)); i++) {
+		IODelay(100);
+	}
+}
+
+/*
+ * Boot 32: frames still tore. The S8 panel runs in command mode: on
+ * every TE the DECON sends the whole buffer to the panel's own frame
+ * memory, also while we copy into it. Samsung's DECON driver masks the
+ * hardware trigger around an update (decon_reg_set_trigger:
+ * HW_SW_TRIG_CONTROL 0x70, HW_TRIG_EN bit 0, HW_TRIG_MASK_DECON bit 4).
+ * Mask it right after a frame-done (no transfer in flight), copy, unmask:
+ * the panel keeps showing the previous frame and then gets a whole one.
+ */
+static void
+sweet_fb_trigger(bool enable)
+{
+	if (sweet_fb_decon == 0) {
+		return;
+	}
+	volatile uint32_t *trig = (volatile uint32_t *)(sweet_fb_decon + 0x70);
+	uint32_t v = *trig & ~((1u << 0) | (1u << 4));
+	*trig = v | (enable ? (1u << 0) : (1u << 4));
+}
+#endif
