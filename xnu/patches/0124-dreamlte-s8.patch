+#if defined(DREAMLTE)
+static uint64_t sweet_fb_stat_start, sweet_fb_stat_swaps, sweet_fb_stat_copies;
+static uint64_t sweet_fb_stat_wait, sweet_fb_stat_copy, sweet_fb_stat_copy_max;
+
+/* Under fPresentLock; timebase 26 MHz, 26 ticks = 1 us. */
+static void
+sweet_fb_stat(uint64_t t0, uint64_t t1, uint64_t t2)
+{
+	sweet_fb_stat_copies++;
+	sweet_fb_stat_wait += t1 - t0;
+	sweet_fb_stat_copy += t2 - t1;
+	if (t2 - t1 > sweet_fb_stat_copy_max) {
+		sweet_fb_stat_copy_max = t2 - t1;
+	}
+	if (sweet_fb_stat_start == 0) {
+		sweet_fb_stat_start = t2;
+	} else if (t2 - sweet_fb_stat_start >= 10ULL * 26000000ULL) {
+		uint64_t n = sweet_fb_stat_copies;
+		IOLog("SWEET FB: 10s: %llu swaps, %llu shown; per frame wait %llu us, copy %llu us (max %llu)\n",
+		    __atomic_load_n(&sweet_fb_stat_swaps, __ATOMIC_RELAXED), n,
+		    sweet_fb_stat_wait / n / 26, sweet_fb_stat_copy / n / 26, sweet_fb_stat_copy_max / 26);
+		sweet_fb_stat_start = t2;
+		__atomic_store_n(&sweet_fb_stat_swaps, 0, __ATOMIC_RELAXED);
+		sweet_fb_stat_copies = sweet_fb_stat_wait = sweet_fb_stat_copy = sweet_fb_stat_copy_max = 0;
+	}
