+static uint32_t sweet_fb_row[SWEET_FB_ROW_MAX];   /* under fPresentLock */
+static uint16_t sweet_fb_xmap[SWEET_FB_ROW_MAX];
+
+/*
+ * Stretch the canvas rectangle (dx, dy, w, h) of a layer, whose first
+ * pixel is at src with stride bpr, over the panel: panel pixel (px, py)
+ * shows canvas pixel (px * lw / pw, py * lh / ph).
+ */
+static void
+sweet_fb_scaled_copy(uintptr_t fb, uint32_t fbBpr, uint32_t pw, uint32_t ph,
+    uint32_t lw, uint32_t lh, uintptr_t src, uint32_t bpr,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	uint32_t px0 = (uint32_t)dx * pw / lw, px1 = (uint32_t)(dx + w) * pw / lw;
+	uint32_t py0 = (uint32_t)dy * ph / lh, py1 = (uint32_t)(dy + h) * ph / lh;
+	if (px1 > pw) {
+		px1 = pw;
+	}
+	if (py1 > ph) {
+		py1 = ph;
+	}
+	if (px1 <= px0 || py1 <= py0) {
+		return;
+	}
+	uint32_t n = px1 - px0;
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t lx = (px0 + i) * lw / pw;
+		int32_t cx = (int32_t)lx - dx;
+		sweet_fb_xmap[i] = (uint16_t)(cx < 0 ? 0 : (cx >= w ? w - 1 : cx));
+	}
+	int32_t built = -1;
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t cy = (int32_t)(py * lh / ph) - dy;
+		cy = cy < 0 ? 0 : (cy >= h ? h - 1 : cy);
+		if (cy != built) {
+			const uint32_t *row = (const uint32_t *)(src + (uint64_t)cy * bpr);
+			for (uint32_t i = 0; i < n; i++) {
+				sweet_fb_row[i] = row[sweet_fb_xmap[i]];
+			}
+			built = cy;
+		}
+		memcpy((void *)(fb + (uint64_t)py * fbBpr + (uint64_t)px0 * 4), sweet_fb_row, (size_t)n * 4);
+	}
+}
