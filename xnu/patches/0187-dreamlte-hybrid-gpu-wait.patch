--- /dev/null
+++ b/iokit/Kernel/arm/DreamPanfrostWait.inc
@@ -0,0 +1,34 @@
+/* HakiOS wait_job policy adapted to the synchronous G71 transport:
+ * at most 200us short polling, then 50us deadline sleeps, one-second bound.
+ * The separate wait mutex is the ONLY lock released while sleeping. The
+ * existing AS0/display exclusion lock stays held until completion/restoration.
+ */
+#ifndef DREAM_PANFROST_WAIT_TEST
+#include <kern/sched_prim.h>
+#endif
+static IOLock *dpf_wait_lock;
+static int dpf_wait_event;
+static bool dpf_wait_job(unsigned slot, uint32_t *irq, uint32_t *mmu,
+    unsigned *checks, unsigned *naps)
+{
+    uint64_t deadline;
+    clock_interval_to_deadline(1000,NSEC_PER_MSEC,&deadline);
+    *checks=*naps=0;
+    for (;;) {
+        *irq=dm_read(dmb_gpu,0x1000); *mmu=dm_read(dmb_gpu,0x2000);
+        ++*checks;
+        if (*mmu || (*irq & ((1u<<slot)|(1u<<(slot+16)))))
+            return !*mmu && (*irq & ((1u<<slot)|(1u<<(slot+16))))==(1u<<slot);
+        if (mach_absolute_time()>=deadline) return false;
+        if (*checks<=20) IODelay(10);
+        else if (dpf_wait_lock) {
+            uint64_t nap;
+            clock_interval_to_deadline(50,NSEC_PER_USEC,&nap);
+            if (nap>deadline) nap=deadline;
+            IOLockLock(dpf_wait_lock);
+            (void)IOLockSleepDeadline(dpf_wait_lock,&dpf_wait_event,nap,THREAD_UNINT);
+            IOLockUnlock(dpf_wait_lock);
+            ++*naps;
+        } else { IOSleep(1); ++*naps; } // Allocation failure retains the old conservative wait.
+    }
+}
