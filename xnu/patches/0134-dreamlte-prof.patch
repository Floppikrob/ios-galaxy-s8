+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/* Galaxy S8 diagnostics (osfmk/kern/s8_prof.c): this process's workqueue counters. */
+void s8_workq_report(void *procp);
+
+void
+s8_workq_report(void *procp)
+{
+	struct workqueue *wq = proc_get_wqptr_fast((struct proc *)procp);
+	if (wq == NULL) {
+		printf("S8WQ: no workqueue\n");
+		return;
+	}
+	printf("S8WQ: creations %u nthreads %u idle %u scheduled %u constrained %u reqcount %u timer %u flags %#x "
+	    "max_threads %u max_constrained %u max_par %u/%u/%u\n",
+	    wq->wq_creations, wq->wq_nthreads, wq->wq_thidlecount, wq->wq_threads_scheduled,
+	    wq->wq_constrained_threads_scheduled, wq->wq_reqcount, wq->wq_timer_interval,
+	    (unsigned)os_atomic_load(&wq->wq_flags, relaxed), wq_max_threads, wq_max_constrained_threads,
+	    wq_max_parallelism[0], wq_max_parallelism[2], wq_max_parallelism[4]);
+}
+#endif
