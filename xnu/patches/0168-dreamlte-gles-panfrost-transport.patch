+/* Exynos8895/G71 Panfrost transport. Uses the proven S8 GPU power state.
+ * No S9 power/PLL/PMIC addresses. Eight blit AS mappings remain allocated.
+ * AS0 is time shared only while dmb_lock excludes every display GPU job;
+ * its complete translation state is restored before returning to the blitter.
+ */
+#include "DreamPanfrostVa.h"
+static void dream_panfrost_start();
+static bool dpf_ready, dpf_failed;
+static uint64_t dpf_root, dpf_seq, dpf_done, dpf_live_bytes;
+static struct mali_va dpf_va;
+static unsigned dpf_pages, dpf_jobs;
+static struct {uint64_t pa;uint64_t *va;} dpf_page_records[2048];
+static bool dpf_ram(uint64_t pa) {return pa>=0x880000000ULL&&pa+4096<=0x900000000ULL;}
+static uint32_t dpf_saved[6];
+static const unsigned dpf_as_offsets[]={0,4,8,12,0x30,0x34};
+static uint64_t *dpf_table_page(uint64_t *pa) {
+    if(dpf_pages>=2048) return NULL;
+    IOBufferMemoryDescriptor *m=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+        kIODirectionInOut|kIOMemoryKernelUserShared,4096,4096);
+    if(!m) return NULL;
+    if(m->prepare()!=kIOReturnSuccess) {m->release();return NULL;}
+    IOByteCount n=0;*pa=m->getPhysicalSegment(0,&n,kIOMemoryMapperNone);
+    if(!*pa||(*pa&4095)||n<4096||!dpf_ram(*pa)) {
+        m->complete();m->release();return NULL;
+    }
+    uint64_t *v=(uint64_t *)m->getBytesNoCopy();bzero(v,4096);dm_clean(v,4096);
+    // Retained for the life of the GPU translation domain, including faults.
+    dpf_page_records[dpf_pages].pa=*pa;dpf_page_records[dpf_pages].va=v;
+    dpf_pages++;return v;
+}
+static uint64_t *dpf_table(uint64_t pa) {
+    pa&=0x000000fffffff000ULL;
+    for(unsigned i=0;i<dpf_pages;i++)if(dpf_page_records[i].pa==pa)return dpf_page_records[i].va;
+    return NULL;
+}
+static uint64_t *dpf_pte(uint64_t va,bool create) {
+    if(va>=0x100000000ULL||!dpf_root) return NULL;
+    uint64_t *t=dpf_table(dpf_root);if(!t)return NULL;
+    for(int shift=39;shift>12;shift-=9) {
+        uint64_t *e=&t[(va>>shift)&511];
+        if(!(*e&1)) {
+            if(!create)return NULL;
+            uint64_t pa=0;uint64_t *child=dpf_table_page(&pa);if(!child)return NULL;
+            *e=pa|3;dm_clean(e,8);
+        }
+        t=dpf_table(*e);if(!t)return NULL;
+    }
+    return &t[(va>>12)&511];
+}
+static bool dpf_update() {
+    if(!dmb_wait(0x2428,1,0))return false;
+    dm_write(dmb_gpu,0x2418,1);
+    return dmb_wait(0x2428,1,0);
+}
+extern "C" bool hakios_mali_ready() {return dpf_ready&&!dpf_failed;}
+extern "C" bool hakios_mali_map(uint64_t va,uint64_t pa) {
+    if(!hakios_mali_ready()||(va&4095)||(pa&4095)||!dpf_ram(pa))return false;
+    uint64_t *e=dpf_pte(va,true);if(!e||(*e&1))return false;
+    // G71 legacy format already used by every successful S8 compute copy.
+    *e=pa|0x2c1;dm_clean(e,8);return true;
+}
+extern "C" uint64_t hakios_mali_address(uint64_t size,bool executable) {
+    if(!hakios_mali_ready()||!size||(size&4095)||size>256ULL*1024*1024||(executable&&size>16ULL*1024*1024)||
+        dpf_live_bytes+size>768ULL*1024*1024)return 0;
+    uint64_t va=mali_va_alloc(&dpf_va,size,executable);
+    if(va)dpf_live_bytes+=size;
+    return va;
+}
+extern "C" void hakios_mali_mapped() {} // UPDATE is mandatory immediately before each chain.
+extern "C" void hakios_mali_unmap(uint64_t va,uint64_t size) {
+    if(dpf_failed)return; // Retain physical storage too; the user client checks this state.
+    IOLockLock(dmb_lock);
+    for(uint64_t off=0;off<size;off+=4096) {
+        uint64_t *e=dpf_pte(va+off,false);if(e){*e=0;dm_clean(e,8);}
+    }
+    // AS0 is restored to a blit domain, never this table, whenever the lock is free.
+    if(mali_va_free(&dpf_va,va,size))dpf_live_bytes-=size;
+    IOLockUnlock(dmb_lock);
+}
+extern "C" void hakios_mali_tag(uint64_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t) {}
+extern "C" bool hakios_mali_parameter(uint32_t which,uint64_t *value) {
+    if(!hakios_mali_ready())return false;
+    static const uint16_t simple[]={0,0,0,0,0,0xe00,0x18,0x1c,4,8,12,16,20,0xac,0xa0,0xa4,0xa8,0x300,0xb0,0xb4,0xb8,0xbc};
+    if(which==0){*value=dm_read(dmb_gpu,0)>>16;return true;}
+    if(which==1){*value=dm_read(dmb_gpu,0)&65535;return true;}
+    if(which>=2&&which<=4){unsigned r=0x100+(which-2)*16;*value=dm_read(dmb_gpu,r)|((uint64_t)dm_read(dmb_gpu,r+4)<<32);return true;}
+    if(which>=22&&which<=37){*value=dm_read(dmb_gpu,0xc0+(which-22)*4);return true;}
+    if(which==38){*value=__builtin_popcount(dm_read(dmb_gpu,0x120));return true;}
+    if(which==39){uint32_t a=dm_read(dmb_gpu,0x310),b=dm_read(dmb_gpu,0xa0);*value=a>b?a:b;return true;}
+    if(which==40){*value=0;return true;}
+    if(which<sizeof(simple)/sizeof(simple[0])&&simple[which]){*value=dm_read(dmb_gpu,simple[which]);return true;}
+    return false;
+}
+static bool dpf_idle() {
+    for(unsigned slot=0;slot<3;slot++)if(dm_read(dmb_gpu,0x1824+slot*0x80)||dm_read(dmb_gpu,0x1860+slot*0x80))return false;
+    return true;
+}
+extern "C" uint64_t hakios_mali_enqueue(uint64_t chain,bool fragment) {
+    if(!hakios_mali_ready()||!chain||(chain&7))return 0;
+    uint64_t *entry=dpf_pte(chain,false);if(!entry||!(*entry&1))return 0;
+    IOLockLock(dmb_lock);
+    bool ok=hakios_mali_ready()&&dmb_ready&&!dmb_poisoned&&dpf_idle();
+    bool switched=false;uint32_t irq=0,mmu=0;unsigned slot=fragment?0:1,js=0x1800+slot*0x80;
+    if(ok) {
+        for(unsigned i=0;i<6;i++)dpf_saved[i]=dm_read(dmb_gpu,0x2400+dpf_as_offsets[i]);
+        ok=dmb_wait(0x2428,1,0);
+        if(ok){
+            switched=true;
+            dm_write(dmb_gpu,0x2400,(uint32_t)dpf_root|7);dm_write(dmb_gpu,0x2404,dpf_root>>32);
+            dm_write(dmb_gpu,0x2408,0x00888d88);dm_write(dmb_gpu,0x240c,0);
+            dm_write(dmb_gpu,0x2430,0);dm_write(dmb_gpu,0x2434,0);ok=dpf_update();
+        }
+    }
+    if(ok) {
+        dm_write(dmb_gpu,0x1004,0xffffffff);dm_write(dmb_gpu,0x2004,0xffffffff);
+        dm_write(dmb_gpu,js+0x40,(uint32_t)chain);dm_write(dmb_gpu,js+0x44,chain>>32);
+        dm_write(dmb_gpu,js+0x50,dmb_shaders);dm_write(dmb_gpu,js+0x54,0);
+        dm_write(dmb_gpu,js+0x58,(8u<<16)|(3u<<8)|(1u<<10)|(3u<<12));dm_write(dmb_gpu,js+0x60,1);
+        ok=false;
+        for(unsigned n=0;n<1000;n++) {
+            irq=dm_read(dmb_gpu,0x1000);mmu=dm_read(dmb_gpu,0x2000);
+            if(mmu||(irq&((1u<<slot)|(1u<<(slot+16))))) {
+                ok=!mmu&&(irq&((1u<<slot)|(1u<<(slot+16))))==(1u<<slot);break;
+            }
+            IOSleep(1);
+        }
+        if(ok)ok=dpf_idle();
+    }
+    if(ok&&switched) {
+        dm_write(dmb_gpu,0x1004,0xffffffff);
+        for(unsigned i=0;i<6;i++)dm_write(dmb_gpu,0x2400+dpf_as_offsets[i],dpf_saved[i]);
+        ok=dpf_update();
+    }
+    uint64_t seq=0;
+    if(ok){seq=++dpf_seq;dpf_done=seq;if(++dpf_jobs<=12||dpf_jobs%300==0)IOLog("DREAM GLES: chain=%llu slot=%u PASS restore_AS0=1 blit_contexts=%u\n",seq,slot,DMB_CONTEXT_LIMIT);}
+    else {
+        dpf_failed=true;dmb_poisoned=true;
+        IOLog("DREAM GLES: FAILED chain=%llx slot=%u irq=%x MMU=%x fault=%x address=%x:%x JS=%x; DMA storage retained, reboot required\n",
+            chain,slot,irq,mmu,dm_read(dmb_gpu,0x241c),dm_read(dmb_gpu,0x2424),dm_read(dmb_gpu,0x2420),dm_read(dmb_gpu,js+0x24));
+        // No reset invalidating eight live contexts, and no freeing hardware-owned memory.
+    }
+    IOLockUnlock(dmb_lock);return seq;
+}
+extern "C" bool hakios_mali_wait(uint64_t seq,uint64_t) {return !dpf_failed&&seq<=dpf_done;}
+static void dpf_backend_start() {
+    if(!dmb_ready||dmb_poisoned||dm_read(dmb_gpu,0)!=0x60a00001)return;
+    uint32_t tiler=dm_read(dmb_gpu,0x110);
+    if(!tiler)return;
+    dm_write(dmb_gpu,0x190,tiler);if(!dmb_wait(0x150,tiler,tiler))return;
+    uint64_t *root=dpf_table_page(&dpf_root);if(!root)return;
+    dpf_ready=true;
+    IOLog("DREAM GLES: G71 transport ready, root=%llx, synchronous chains, AS0 shared with 8 retained blit contexts, tiler=%x\n",dpf_root,tiler);
+}
