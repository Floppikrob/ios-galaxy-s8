+/* Optional protocol isolation: complete STOP before the response read. */
+static int s8fts_split;
+
+static bool
+s8fts_wait_idle(void)
+{
+    for (unsigned us = 0; us < 20000; us++) {
+        if (!(a5touch_read(s8ts_i2c, 0x50) & (1u << 17))) return true;
+        delay(1);
+    }
+    return false;
+}
