+/* Do not spend a ninth AS on a new display mirror: caller can keep its
+ * canonical BGRA stage/context. Reserve one AS for that fallback if the stage
+ * has not yet been used; already-mapped mirrors can always reuse their AS. */
+static bool dream_gpu_frame_source_room(SweetSurface *source) {
+    if(!source || !source->memory || !dmb_lock)return false;
+    IOLockLock(dmb_lock);
+    bool room=dmb_ready&&!dmb_poisoned && dmb_count+1<DMB_CONTEXT_LIMIT &&
+        (dm_read(dmb_gpu,0x18)&(1u<<dmb_count));
+    for(unsigned i=0;i<dmb_count;i++)if(dmb_contexts[i].src==source->memory)room=dmb_ready&&!dmb_poisoned;
+    IOLockUnlock(dmb_lock);return room;
+}
