+// Only the guarded boot-bypass owner calls this. A fault is never accepted as
+// a successful translation: acknowledge it only while returning to saved bypass.
+static bool df_restore_mmu_bypass(volatile uint32_t *m,uint32_t pt,uint32_t ctrl) {
+    df_write(m,0,7);
+    if(!df_wait(m,8,1,1,20))return false; // Keep tables/DMA retained.
+    const uint32_t fault=m[0x60/4];
+    df_write(m,0xc,pt);df_write(m,0x10,1);
+    if(fault)df_write(m,0x64,fault); // Samsung v7 INT_CLEAR, observed W1C bits only.
+    df_write(m,0,ctrl);
+    bool ok=df_wait(m,0,~0u,ctrl,20) && m[3]==pt && !m[0x60/4];
+    IOLog("DREAM FLIP RESTORE: bypass=%u control=%x pt=%x fault_before=%x fault_after=%x retained=1\n",
+        ok,m[0],m[3],fault,m[0x60/4]);
+    return ok;
+}
+// Restore the saved scanout request AND confirm a fresh frame after a failed
+// domain transition. Merely restoring MMU_CTRL does not prove IDMA resumed.
+static bool df_restore_boot_scanout(volatile uint32_t *d,volatile uint32_t *i,uint32_t base,uint32_t base_c) {
+    const uint32_t saved=d[0x40/4];
+    df_write(d,0x40,saved|(1u<<13)|1u);
+    df_write(i,4,(i[1]&0xffffu)|0xab0000u);
+    df_write(d,0x4c,1u<<13); // Clear BEFORE commit so a fast completion is retained.
+    df_write(i,0x40,base);df_write(i,0x44,base_c);
+    df_write(d,0x60,d[0x60/4]|0x8000003f);
+    bool latched=df_wait(d,0x60,0x8000003f,0,100);
+    bool retired=latched&&df_wait(d,0x4c,1u<<13,1u<<13,40);
+    df_write(d,0x40,saved);
+    uint32_t errors=i[1]&0xaa0000u;
+    IOLog("DREAM FLIP RESTORE: boot_latch=%u retired=%u DMA=%x base=%x retained=1\n",
+        latched,retired,errors,i[0x40/4]);
+    return latched&&retired&&!errors&&i[0x40/4]==base&&i[0x44/4]==base_c;
+}
