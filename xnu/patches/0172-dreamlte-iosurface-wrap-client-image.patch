+/* iOS16.7 IOSurfaceClientWrapClientImage selector6: exact32-byte input,
+ * decoded from the same cache that calls this ABI. Return real mapped state;
+ * a zero-filled successful result creates a bogus client and crashes its
+ * GetBulkAttachments memcpy from state+0x30.
+ */
+struct DreamWrapImageRequest {
+    uint64_t address;
+    uint32_t width,height,pixelFormat,bytesPerElement,bytesPerRow,tailWord;
+};
+static_assert(sizeof(DreamWrapImageRequest)==32,"WrapClientImage ABI");
+static IOReturn
+dream_surface_wrap(task_t owner,const void *input,size_t inputSize,SweetSurface **result)
+{
+    *result=NULL;
+    if(!input || inputSize!=sizeof(DreamWrapImageRequest))return kIOReturnBadArgument;
+    DreamWrapImageRequest q;memcpy(&q,input,sizeof(q));
+    if(!q.address || !q.width || !q.height || q.width>SWEET_SURFACE_MAX_DIM || q.height>SWEET_SURFACE_MAX_DIM)
+        return kIOReturnBadArgument;
+    if(q.bytesPerElement!=1 && q.bytesPerElement!=2 && q.bytesPerElement!=4 && q.bytesPerElement!=8 && q.bytesPerElement!=16)
+        return kIOReturnBadArgument;
+    if((q.pixelFormat==0 || q.pixelFormat==0x42475241 || q.pixelFormat==0x52474241 ||
+        q.pixelFormat==0x41524742 || q.pixelFormat==0x41424752) && q.bytesPerElement!=4)
+        return kIOReturnBadArgument;
+    uint64_t span=(uint64_t)q.bytesPerRow*q.height;
+    if(q.bytesPerRow<(uint64_t)q.width*q.bytesPerElement || !span || span>SWEET_SURFACE_MAX_ALLOC || q.address+span<q.address)
+        return kIOReturnBadArgument;
+    SweetSurface *s=sweet_surface_alloc();if(!s)return kIOReturnNoMemory;
+    IOMemoryDescriptor *memory=IOMemoryDescriptor::withAddressRange(q.address,span,kIODirectionInOut,owner);
+    if(!memory){s->release();return kIOReturnNoMemory;}
+    IOReturn ret=memory->prepare();
+    if(ret!=kIOReturnSuccess){memory->release();s->release();return ret;}
+    uint64_t previous=(uint64_t)OSAddAtomic64(span,(volatile SInt64 *)&sweet_surface_wired);
+    if(previous+span>SWEET_SURFACE_WIRED_MAX) {
+        OSAddAtomic64(-(SInt64)span,(volatile SInt64 *)&sweet_surface_wired);
+        memory->complete();memory->release();s->release();return kIOReturnNoMemory;
+    }
+    s->memory=memory;s->userMemoryPrepared=true;s->mapCache=kIOMapDefaultCache;
+    s->width=q.width;s->height=q.height;s->bytesPerRow=q.bytesPerRow;s->pixelFormat=q.pixelFormat;
+    s->bytesPerElement=(uint16_t)q.bytesPerElement;s->elementWidth=s->elementHeight=1;
+    s->allocSize=(uint32_t)span;s->offset=0;s->planeCount=0;
+    *result=s;
+    return kIOReturnSuccess;
+}
