  * G71 is non-coherent: cover ordinary BOs as well as imported surfaces before
  * submission and after synchronous completion. Never invalidate live DMA.
  */
+static uint64_t dpf_clean_bytes, dpf_invalidate_bytes, dpf_heap_skips;
 static void dpf_sync_buffer(struct mali_buffer *b, bool to_gpu) {
     if (!b || !b->memory) return;
+    bool heap = b->gpuOnlyHeap && !b->cpuMapped && !b->surface;
+    // This BO has never been mapped to a CPU client. Publish allocator writes
+    // once, then leave GPU-owned heap/cache lines alone. Never invalidate live DMA.
+    if (heap && (b->heapPrimed || !to_gpu)) { ++dpf_heap_skips; return; }
     void *address=NULL;
     uint64_t length=b->size;
     if (b->surface) {
@@ -14,8 +19,19 @@
         if(m) address=m->getBytesNoCopy();
     }
     if(!address || !length || length>b->memory->getLength()) return;
-    if(to_gpu) dm_clean(address,length);
-    else dm_invalidate(address,length);
+    if(to_gpu) {
+        dm_clean(address,length); dpf_clean_bytes += length;
+        if (heap) b->heapPrimed = true;
+    } else { dm_invalidate(address,length); dpf_invalidate_bytes += length; }
 }
 static void flushSubmit(struct mali_buffer *b) { dpf_sync_buffer(b,true); }
 static void flushComplete(struct mali_buffer *b) { dpf_sync_buffer(b,false); }
+
+static bool dpf_begin_cpu_mapping(struct mali_buffer *b) {
+    // Never invalidate or expose storage still owned by a failed GPU chain.
+    if (!b || !hakios_mali_ready()) return false;
+    bool used = b->gpuOnlyHeap && !b->cpuMapped && b->heapPrimed;
+    b->cpuMapped = true;
+    if (used) flushComplete(b);
+    return true;
+}
