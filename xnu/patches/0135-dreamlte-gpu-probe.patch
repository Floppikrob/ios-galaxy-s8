 	extern void s8_cpufreq_start(void);
 	extern void s8_load_start(void);
 	s8_cpufreq_start();
+	extern void s8_gpu_start(void);
+	s8_gpu_start();                 /* boot-arg s8gpu=1 (bsd/dev/s8_gpu.c), after the G3D clock */
 	s8_load_start();
 	extern void s8_prof_start(void);
 	s8_prof_start();                /* boot-arg s8prof=NAME (osfmk/kern/s8_prof.c) */                /* per-CPU load every 10 s (osfmk/kern/s8_load.c) */             /* boot-arg s8cpufreq=KHZ (bsd/dev/s8_cpufreq.c) */
